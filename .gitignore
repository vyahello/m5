# Python virtualenv (regenerable: python -m venv venv && pip install esptool pyserial)
venv/
.venv/

# Editor / tooling
.idea/
.claude/

# Large firmware binaries — keep out of version control.
# (App image + full device snapshots; see docs/03-flashing-bruce.md to recreate.)
firmware/*.bin

# Python caches
__pycache__/
*.pyc

# Loot / captures pulled off the device (bruce-get.sh default dest) — client
# evidence: handshakes, creds, dumps. NEVER commit. Exfil locally, handle per scope.
loot/
*.pcap
*.cap
*.hc22000
*_creds.csv
loot/
